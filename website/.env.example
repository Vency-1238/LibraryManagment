# ─────────────────────────────────────────────────────────────
# Appwrite configuration
# Set these in Vercel → Project → Settings → Environment Variables
# (they are also used by the local seed script via .env).
# ─────────────────────────────────────────────────────────────
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_STUDENTS_COLLECTION_ID=your_students_collection_id
VITE_APPWRITE_BOOKS_COLLECTION_ID=your_books_collection_id
VITE_APPWRITE_BORROW_COLLECTION_ID=your_borrow_collection_id

# Optional until you create the ScanLogs collection in the Appwrite Console.
# Use the same value for both names; the VITE_ name is read by the dashboard
# and the APPWRITE_ name is read by the Vercel API.
VITE_APPWRITE_SCANLOGS_COLLECTION_ID=your_scanlogs_collection_id
APPWRITE_SCANLOGS_COLLECTION_ID=your_scanlogs_collection_id

# Optional. Used by api-lib and scripts/seed.js only; never sent to the browser.
# Recommended scopes: databases.read, collections.read, documents.read,
# documents.write. Without them the API retries with Appwrite's public
# collection permissions, so those permissions must allow the operations.
APPWRITE_API_KEY=your_api_key_here
